<mxfile host="app.diagrams.net"><diagram id="mapa" name="Mapa de empatía"><mxGraphModel dx="1000" dy="650" grid="1" gridSize="10" page="1" pageWidth="940" pageHeight="600" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Mapa de empatía&lt;/b&gt; · Vendedor de ELECTRORIOS" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1F2A2E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;DICE&lt;/b&gt;" style="rounded=1;arcSize=18;html=1;fillColor=#2E6DA4;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=15;align=left;spacingLeft=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="370" height="38" as="geometry"/></mxCell><mxCell id="c3" value="• «Soy vendedor»&lt;br&gt;&lt;br&gt;• «Llevo más de 3 años trabajando»&lt;br&gt;&lt;br&gt;• «Soy paciente»&lt;br&gt;&lt;br&gt;• «A veces se me hace un poco difícil llevar todo manualmente»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF4FA;strokeColor=#2E6DA4;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;fontSize=13;fontColor=#1F2A2E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="104" width="370" height="196" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;PIENSA&lt;/b&gt;" style="rounded=1;arcSize=18;html=1;fillColor=#B9730F;strokeColor=#B9730F;fontColor=#FFFFFF;fontSize=15;align=left;spacingLeft=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="70" width="370" height="38" as="geometry"/></mxCell><mxCell id="c5" value="• Llevar todo de forma manual le complica el trabajo&lt;br&gt;&lt;br&gt;• No siempre puede confirmar si hay un producto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF4E8;strokeColor=#B9730F;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;fontSize=13;fontColor=#1F2A2E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="104" width="370" height="196" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;HACE&lt;/b&gt;" style="rounded=1;arcSize=18;html=1;fillColor=#146B43;strokeColor=#146B43;fontColor=#FFFFFF;fontSize=15;align=left;spacingLeft=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="370" height="38" as="geometry"/></mxCell><mxCell id="c7" value="• Anota las cosas en un cuaderno&lt;br&gt;&lt;br&gt;• Explica con paciencia los productos a los clientes&lt;br&gt;&lt;br&gt;• Cuando no hay lo que piden, sugiere un producto parecido" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF6F0;strokeColor=#146B43;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;fontSize=13;fontColor=#1F2A2E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="354" width="370" height="196" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SIENTE&lt;/b&gt;" style="rounded=1;arcSize=18;html=1;fillColor=#A23B5A;strokeColor=#A23B5A;fontColor=#FFFFFF;fontSize=15;align=left;spacingLeft=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="320" width="370" height="38" as="geometry"/></mxCell><mxCell id="c9" value="• Seguridad al atender a los clientes&lt;br&gt;&lt;br&gt;• Incertidumbre cuando no sabe si hay un producto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEEF2;strokeColor=#A23B5A;align=left;verticalAlign=top;spacingLeft=16;spacingRight=14;spacingTop=14;fontSize=13;fontColor=#1F2A2E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="354" width="370" height="196" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#1F2A2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="443" y="215" width="54" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Vendedor&lt;/b&gt;&lt;br&gt;más de 3 años&lt;br&gt;en la tienda" style="text;html=1;align=center;verticalAlign=top;fontSize=12;fontColor=#1F2A2E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="315" width="140" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Fuente: ensayo de entrevista GA-TL-02, equipo CPR, 20 de noviembre de 2026." style="text;html=1;align=left;fontSize=11;fontColor=#5F6B6D;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>